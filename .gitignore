/target

# `scripts/package-release.*` writes the release archives here; CI uploads them straight
# from the runner, so nothing in here is ever committed.
/dist

# Dev-only local overrides. `[patch.crates-io]` here points at sibling checkouts **outside this
# repository**, and cargo treats a patch aimed at a missing path as a **hard error** -- so
# committing this file would break every lone clone and every CI run. It must stay ignored.
/.cargo/config.toml

# The integration-test fixtures are built **in place** (they have a path dependency
# on the crate under test, so copying them out breaks that), which leaves a lockfile
# beside them. The build output itself goes to a temp dir via --target-dir.
crates/*/tests/fixtures/*/Cargo.lock
crates/*/tests/fixtures/*/target

# IDE
/.idea
/.vscode/*.log
*.swp

# Scratch
/.scratch
*.tmp
